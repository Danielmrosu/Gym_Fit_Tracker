            on_press: app.root.current = "home"

# === SETTINGS SCREEN ===
<SettingsScreen>:
    name: "settings"
# Spacing & Layout Expansion:
#   - Increase vertical height, line-height, and padding for each
    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        ScreenLabel:
            text: "Settings"

        DarkCard:
            Label:
                text: "Weight Unit"
                font_size: dp(14)
                halign: "left"
                size_hint_y: None
                height: dp(32)

            Spinner:
                id: weight_unit_spinner
                text: "kg"
                font_size: dp(14)
                values: ["kg", "lbs"]
                size_hint_y: None
                height: dp(40)

        DarkCard:
            Label:
                text: "Default Rest Time"
                font_size: dp(14)
                halign: "left"
                size_hint_y: None
                height: dp(32)

            Spinner:
                id: rest_time_spinner
                text: "60s"
                font_size: dp(14)
                values: ["30s", "45s", "60s", "90s", "120s", "180s"]
                size_hint_y: None
                height: dp(40)

        DarkCard:
            Label:
                text: "Default Reps"
                font_size: dp(14)
                halign: "left"
                size_hint_y: None
                height: dp(32)

            Spinner:
                id: default_reps_spinner
                text: "10"
                font_size: dp(14)
                values: ["5", "6", "8", "10", "12", "15", "20"]
                size_hint_y: None
                height: dp(40)

        DarkButton:
            text: "Backup Database"
            size_hint_y: None
            height: dp(44)
            on_press: root.backup_database()

        RedButton:
            text: "Reset All Data"
            size_hint_y: None
            height: dp(44)
            on_press: root.reset_data()

        Widget:

        GhostButton:
            text: "Back"
            size_hint_y: None
            height: dp(42)
            on_press: root.go_back()

# === NUTRITION SCREEN ===
<NutritionScreen>:
    name: "nutrition"

    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)

            Button:
                text: "Home"
                size_hint_x: 0.2
                font_size: dp(12)
                background_color: 0.18, 0.168, 0.15, 1
                color: 0.658, 0.631, 0.588, 1
                on_press: app.root.current = "home"

            Button:
                text: "<"
                size_hint_x: 0.1
                font_size: dp(16)
                background_color: 0.18, 0.168, 0.15, 1
                color: 0.658, 0.631, 0.588, 1
                on_press: root.prev_day()

            Label:
                id: date_label
                text: "Today"
                font_size: dp(16)
                bold: True

            Button:
                text: ">"
                size_hint_x: 0.1
                font_size: dp(16)
                background_color: 0.18, 0.168, 0.15, 1
                color: 0.658, 0.631, 0.588, 1
                on_press: root.next_day()

        DarkCard:
            size_hint_y: None
            height: dp(90)

            GridLayout:
                cols: 4
                spacing: dp(4)

                BoxLayout:
                    orientation: "vertical"
                    Label:
                        id: total_calories
                        text: "0"
                        font_size: dp(20)
                        bold: True
                        color: 0.757, 0.267, 0.235, 1
                    Label:
                        text: "Calories"
                        font_size: dp(10)
                        color: 0.658, 0.631, 0.588, 1

                BoxLayout:
                    orientation: "vertical"
                    Label:
                        id: total_protein
                        text: "0g"
                        font_size: dp(16)
                        bold: True
                        color: 0.478, 0.62, 0.435, 1
                    Label:
                        text: "Protein"
                        font_size: dp(10)
                        color: 0.658, 0.631, 0.588, 1

                BoxLayout:
                    orientation: "vertical"
                    Label:
                        id: total_carbs
                        text: "0g"
                        font_size: dp(16)
                        bold: True
                        color: 0.435, 0.545, 0.639, 1
                    Label:
                        text: "Carbs"
                        font_size: dp(10)
                        color: 0.658, 0.631, 0.588, 1

                BoxLayout:
                    orientation: "vertical"
                    Label:
                        id: total_fat
                        text: "0g"
                        font_size: dp(16)
                        bold: True
                        color: 0.788, 0.635, 0.294, 1
                    Label:
                        text: "Fat"
                        font_size: dp(10)
                        color: 0.658, 0.631, 0.588, 1

        DarkCard:
            size_hint_y: None
            height: dp(80)

            BoxLayout:
                spacing: dp(8)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.5

                    BoxLayout:
                        size_hint_y: None
                        height: dp(22)

                        Label:
                            text: "Water Intake"
                            font_size: dp(13)
                            bold: True
                            halign: "left"
                            size_hint_x: 0.6

                        Button:
                            text: "Goal"
                            font_size: dp(10)
                            size_hint_x: 0.4
                            background_color: 0.18, 0.168, 0.15, 1
                            color: 0.658, 0.631, 0.588, 1
                            on_press: root.set_water_goal()

                    Label:
                        id: water_total
                        text: "0ml / 2000ml"
                        font_size: dp(12)
                        bold: True
                        color: 0.435, 0.545, 0.639, 1

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.3

                    Label:
                        id: water_percent
                        text: "0%"
                        font_size: dp(28)
                        bold: True
                        color: 0.478, 0.62, 0.435, 1

                    Label:
                        id: water_goal_label
                        text: "Goal: 2000ml"
                        font_size: dp(10)
                        color: 0.658, 0.631, 0.588, 1

                Button:
                    text: "+"
                    size_hint_x: 0.15
                    font_size: dp(18)
                    background_color: 0.435, 0.545, 0.639, 1
                    color: 1, 1, 1, 1
                    on_press: root.add_water()

                Button:
                    text: "Entries"
                    size_hint_x: 0.2
                    font_size: dp(11)
                    background_color: 0.478, 0.62, 0.435, 1
                    color: 1, 1, 1, 1
                    on_press: root.show_water_entries()

        ScrollView:
            size_hint_y: 6
            bar_color: 0.48, 0.45, 0.41, 0.5
            bar_width: dp(4)
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    padding: [0, dp(4), 0, dp(4)]

                    Label:
                        text: "Breakfast"
                        font_size: dp(14)
                        bold: True
                        halign: "left"
                        size_hint_x: 0.45

                    Button:
                        text: "Recipes"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.435, 0.545, 0.639, 1
                        color: 1, 1, 1, 1
                        on_press: root.show_recipes("Breakfast")

                    Button:
                        text: "+ Add"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.18, 0.168, 0.15, 1
                        color: 0.658, 0.631, 0.588, 1
                        on_press: root.add_food("Breakfast")

                BoxLayout:
                    id: breakfast_container
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(4)
                    padding: [dp(8), 0]

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    padding: [0, dp(8), 0, dp(4)]

                    Label:
                        text: "Lunch"
                        font_size: dp(14)
                        bold: True
                        halign: "left"
                        size_hint_x: 0.45

                    Button:
                        text: "Recipes"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.435, 0.545, 0.639, 1
                        color: 1, 1, 1, 1
                        on_press: root.show_recipes("Lunch")

                    Button:
                        text: "+ Add"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.18, 0.168, 0.15, 1
                        color: 0.658, 0.631, 0.588, 1
                        on_press: root.add_food("Lunch")

                BoxLayout:
                    id: lunch_container
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(4)
                    padding: [dp(8), 0]

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    padding: [0, dp(8), 0, dp(4)]

                    Label:
                        text: "Dinner"
                        font_size: dp(14)
                        bold: True
                        halign: "left"
                        size_hint_x: 0.45

                    Button:
                        text: "Recipes"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.435, 0.545, 0.639, 1
                        color: 1, 1, 1, 1
                        on_press: root.show_recipes("Dinner")

                    Button:
                        text: "+ Add"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.18, 0.168, 0.15, 1
                        color: 0.658, 0.631, 0.588, 1
                        on_press: root.add_food("Dinner")

                BoxLayout:
                    id: dinner_container
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(4)
                    padding: [dp(8), 0]

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    padding: [0, dp(8), 0, dp(4)]

                    Label:
                        text: "Snacks"
                        font_size: dp(14)
                        bold: True
                        halign: "left"
                        size_hint_x: 0.45

                    Button:
                        text: "Recipes"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.435, 0.545, 0.639, 1
                        color: 1, 1, 1, 1
                        on_press: root.show_recipes("Snacks")

                    Button:
                        text: "+ Add"
                        font_size: dp(11)
                        size_hint_x: 0.25
                        background_color: 0.18, 0.168, 0.15, 1
                        color: 0.658, 0.631, 0.588, 1
                        on_press: root.add_food("Snacks")

                BoxLayout:
                    id: snacks_container
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(4)
                    padding: [dp(8), 0]

        DarkCard:
            size_hint_y: None
            height: dp(49)

            Button:
                text: "Create New Recipe"
                font_size: dp(14)
                bold: True
                background_color: 0.478, 0.62, 0.435, 1
                color: 1, 1, 1, 1
                on_press: root.create_recipe()

        Widget:

# === CALENDAR SCREEN ===
<CalendarScreen>:
    name: "calendar"

    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)

            Button:
                text: "< Home"
                size_hint_x: 0.25
                font_size: dp(12)
                background_color: 0.18, 0.168, 0.15, 1
                color: 0.658, 0.631, 0.588, 1
                on_press: app.root.current = "home"

            Button:
                text: "<"
                size_hint_x: 0.1
                font_size: dp(16)
                background_color: 0.18, 0.168, 0.15, 1
                color: 0.658, 0.631, 0.588, 1
                on_press: root.prev_month()

            Label:
                id: month_label
                text: ""
                font_size: dp(16)
                bold: True

            Button:
                text: ">"
                size_hint_x: 0.15
                font_size: dp(16)
                background_color: 0.18, 0.168, 0.15, 1
                color: 0.658, 0.631, 0.588, 1
                on_press: root.next_month()

        BoxLayout:
            size_hint_y: None
            height: dp(16)
            spacing: dp(4)

            BoxLayout:
                spacing: dp(4)

                Widget:
                    size_hint_x: None
                    width: dp(12)
                    canvas.before:
                        Color:
                            rgba: 0.435, 0.545, 0.639, 1
                        Rectangle:
                            pos: self.pos
                            size: [dp(10), dp(10)]
                Label:
                    text: "Today"
                    font_size: dp(10)
                    color: 0.658, 0.631, 0.588, 1

                Widget:
                    size_hint_x: None
                    width: dp(12)
                    canvas.before:
                        Color:
                            rgba: 0.478, 0.62, 0.435, 1
                        Rectangle:
                            pos: self.pos
                            size: [dp(10), dp(10)]
                Label:
                    text: "Workout"
                    font_size: dp(10)
                    color: 0.658, 0.631, 0.588, 1

        GridLayout:
            id: calendar_grid
            cols: 7
            spacing: dp(4)

        DarkCard:
            size_hint_y: 1.3

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)

                Label:
                    id: selected_date
                    text: "Select a day"
                    font_size: dp(14)
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                ScrollView:
                    BoxLayout:
                        id: workout_list_container
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)

#        Widget:
